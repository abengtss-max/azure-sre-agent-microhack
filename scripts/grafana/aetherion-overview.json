          "subscription": "__SUB_ID__",
          "azureMonitor": {
            "resources": [ { "subscription": "__SUB_ID__", "resourceGroup": "__RG__", "resourceName": "__PG__", "metricNamespace": "microsoft.dbforpostgresql/flexibleservers" } ],
